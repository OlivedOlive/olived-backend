// OLIVED Studio database. A label is the combination of:
//   catalog (products, templates) x market rules (rule sets, claims) x client brand (assets, importers).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Accounts ----------

enum Role {
  CLIENT_MEMBER
  CLIENT_ADMIN
  OLIVED_REVIEWER
  OLIVED_ADMIN
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(160)
  country   String?  @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  brandAssets BrandAsset[]
  importers   Importer[]
  designs     Design[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  sessions       Session[]
  designsCreated Design[]
  versions       DesignVersion[]
  approvals      Approval[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(CLIENT_MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64) // SHA-256 of the cookie value, so a database leak exposes no logins
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @db.VarChar(254)
  role           Role      @default(CLIENT_MEMBER)
  tokenHash      String    @unique @db.Char(64)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

// ---------- Catalog ----------

enum PackagingKind {
  BOTTLE_LABEL
  TIN
  SHIPPING_CARTON
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sku       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(160)
  volumeMl  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  templates PackagingTemplate[]

  @@index([productId])
  @@map("product_variants")
}

model PackagingTemplate {
  id         String        @id @default(cuid())
  variantId  String
  kind       PackagingKind
  name       String        @db.VarChar(160)
  widthMm    Decimal       @db.Decimal(7, 2)
  heightMm   Decimal       @db.Decimal(7, 2)
  bleedMm    Decimal       @default(3) @db.Decimal(5, 2)
  dielineKey String?       @db.VarChar(512) // file in object storage
  zones      Json // editable and locked areas of the label
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  variant     ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  marketRules TemplateMarketRule[]
  designs     Design[]

  @@index([variantId])
  @@map("packaging_templates")
}

// ---------- Market rules ----------

enum RuleSetStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model Market {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(8) // CA, US, EU...
  name      String   @db.VarChar(120)
  languages Json // label languages, for example ["en", "fr"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleSets       RuleSet[]
  approvedClaims ApprovedClaim[]
  importers      Importer[]
  designs        Design[]

  @@map("markets")
}

/// Rule sets are versioned so each design keeps a record of the rules it was checked against.
model RuleSet {
  id          String        @id @default(cuid())
  marketId    String
  version     Int
  status      RuleSetStatus @default(DRAFT)
  rules       Json
  sourceNotes String?       @db.Text // where the rules come from, and who verified them
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  market            Market               @relation(fields: [marketId], references: [id], onDelete: Restrict)
  templateRules     TemplateMarketRule[]
  validationResults ValidationResult[]

  @@unique([marketId, version])
  @@map("rule_sets")
}

model TemplateMarketRule {
  id         String @id @default(cuid())
  templateId String
  ruleSetId  String
  overrides  Json? // for example a larger minimum text size on a small label

  template PackagingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ruleSet  RuleSet           @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([templateId, ruleSetId])
  @@index([ruleSetId])
  @@map("template_market_rules")
}

model ApprovedClaim {
  id        String   @id @default(cuid())
  marketId  String
  locale    String   @db.VarChar(8)
  text      String   @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, locale])
  @@map("approved_claims")
}

// ---------- Client brand ----------

model BrandAsset {
  id             String   @id @default(cuid())
  organizationId String
  name           String   @db.VarChar(160)
  storageKey     String   @db.VarChar(512)
  mimeType       String   @db.VarChar(120)
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("brand_assets")
}

model Importer {
  id             String   @id @default(cuid())
  organizationId String
  marketId       String
  legalName      String   @db.VarChar(200)
  address        String   @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  market       Market       @relation(fields: [marketId], references: [id], onDelete: Restrict)
  designs      Design[]

  @@index([organizationId])
  @@index([marketId])
  @@map("importers")
}

// ---------- Designs ----------

enum DesignStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

model Design {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  templateId     String
  marketId       String
  importerId     String?
  name           String       @db.VarChar(160)
  status         DesignStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  template     PackagingTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  market       Market            @relation(fields: [marketId], references: [id], onDelete: Restrict)
  importer     Importer?         @relation(fields: [importerId], references: [id], onDelete: SetNull)
  versions     DesignVersion[]

  @@index([organizationId, updatedAt])
  @@index([templateId])
  @@index([marketId])
  @@index([createdById])
  @@index([importerId])
  @@map("designs")
}

/// Versions are never edited, so an approval always points at exactly what was approved.
model DesignVersion {
  id          String   @id @default(cuid())
  designId    String
  number      Int
  content     Json
  createdById String
  createdAt   DateTime @default(now())

  design            Design             @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  validationResults ValidationResult[]
  approvals         Approval[]
  printFiles        PrintFile[]

  @@unique([designId, number])
  @@index([createdById])
  @@map("design_versions")
}

model ValidationResult {
  id        String   @id @default(cuid())
  versionId String
  ruleSetId String
  passed    Boolean
  issues    Json
  createdAt DateTime @default(now())

  version DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  ruleSet RuleSet       @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([ruleSetId])
  @@map("validation_results")
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

model Approval {
  id         String           @id @default(cuid())
  versionId  String
  reviewerId String
  decision   ApprovalDecision
  comment    String?          @db.Text
  createdAt  DateTime         @default(now())

  version  DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer User          @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([reviewerId])
  @@map("approvals")
}

model PrintFile {
  id         String   @id @default(cuid())
  versionId  String
  storageKey String   @db.VarChar(512)
  sizeBytes  Int
  createdAt  DateTime @default(now())

  version DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("print_files")
}

// ---------- Operations ----------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String   @db.VarChar(80)
  entityType     String   @db.VarChar(80)
  entityId       String   @db.VarChar(40)
  details        Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_log")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Background work, read by the worker process.
model Job {
  id          String    @id @default(cuid())
  type        String    @db.VarChar(80)
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@map("jobs")
}
