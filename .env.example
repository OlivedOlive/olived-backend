# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# Origins allowed to call the API (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000

# Set to true behind a reverse proxy so rate limiting sees the real client IP
TRUST_PROXY=false

# Enquiries are appended to $DATA_DIR/enquiries.jsonl
DATA_DIR=data
# Store the sender's IP with each enquiry (personal data)
STORE_IP=false

# SMTP — leave SMTP_HOST empty in development: enquiries are saved but not emailed
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OLIVED Website <no-reply@olived.tn>"
MAIL_TO=Contact@olived.tn

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15
