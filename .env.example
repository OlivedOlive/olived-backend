# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# Origins allowed to call the API (comma-separated).
# Production: the real site, e.g. https://olived.tn,https://www.olived.tn
FRONTEND_ORIGIN=http://localhost:3000

# Must be true behind a reverse proxy (nginx, Render, Railway…). If it stays false there,
# every visitor counts as the same IP and shares a single rate limit.
TRUST_PROXY=false

# Enquiries are appended to $DATA_DIR/enquiries.jsonl.
# Production: use a persistent disk; many hosts wipe local files on each deploy.
DATA_DIR=data
# Store the sender's IP with each enquiry (personal data)
STORE_IP=false

# SMTP — olived.tn mail is hosted by Hostinger (MX: mx1/mx2.hostinger.com).
# Leave SMTP_HOST empty to only save enquiries (no email).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
# Full mailbox address and its password (hPanel > Emails > Email accounts)
SMTP_USER=
SMTP_PASS=
# Name only = send from SMTP_USER (Hostinger rejects other sender addresses)
MAIL_FROM="OLIVED Website"
# Where enquiries are delivered (comma-separate for several)
MAIL_TO=Contact@olived.tn

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15
