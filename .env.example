# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# Origins allowed to call the API (comma-separated). The studio pages are on the same site.
# Production: the real site, e.g. https://olived.tn,https://www.olived.tn
FRONTEND_ORIGIN=http://localhost:3000

# Must be true behind a reverse proxy (nginx, Render, Railway…). If it stays false there,
# every visitor counts as the same IP and shares a single rate limit.
TRUST_PROXY=false

# Enquiries are appended to $DATA_DIR/enquiries.jsonl.
# Production: use a persistent disk; many hosts wipe local files on each deploy.
DATA_DIR=data
# Store the sender's IP with each enquiry (personal data)
STORE_IP=false

# SMTP — olived.tn mail is hosted by Hostinger (MX: mx1/mx2.hostinger.com).
# Leave SMTP_HOST empty to only save enquiries (no email).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
# Full mailbox address and its password (hPanel > Emails > Email accounts)
SMTP_USER=
SMTP_PASS=
# Name only = send from SMTP_USER (Hostinger rejects other sender addresses)
MAIL_FROM="OLIVED Website"
# Where enquiries are delivered (comma-separate for several)
MAIL_TO=Contact@olived.tn

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15

# ---------- OLIVED Studio ----------
# MySQL database of the studio. Leave empty to turn the studio off (enquiries keep working).
# Example: mysql://olived_studio:your-password@127.0.0.1:3306/olived_studio
DATABASE_URL=

# Days a studio login lasts without being used. Using the studio renews it,
# so you stay logged in until you log out or stay away this long.
SESSION_DAYS=30

# Makes the studio login cookie HTTPS only. Must be true in production.
COOKIE_SECURE=false

# Studio sign-ups, and failed logins, allowed per IP address every 15 minutes.
AUTH_RATE_LIMIT_MAX=20

# Wrong passwords for one account before it is locked for 15 minutes.
LOGIN_MAX_FAILURES=5

# Optional. `npm run db:seed` creates an OLIVED admin who can review designs.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Optional. A separate database for `npm test`, which EMPTIES it. Its name must contain "test".
# TEST_DATABASE_URL=mysql://olived_studio:your-password@127.0.0.1:3306/olived_studio_test
